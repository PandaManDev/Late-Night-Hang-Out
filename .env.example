# Create a Discord application/bot at https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
# Optional: set this to register slash commands instantly in one test server.
GUILD_ID=

# Optional status text
BOT_STATUS=the late night vibes

# Admin dashboard
# Create an OAuth2 redirect URI in the Discord Developer Portal that exactly matches this URL.
# For a public dashboard, use HTTPS (a domain or HTTPS tunnel) rather than plain HTTP.
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_secret
DASHBOARD_PORT=16210
DASHBOARD_REDIRECT_URI=https://your-domain.example/auth/callback
DASHBOARD_HTTPS=true
